# Python-Umgebung und Caches
.venv/
__pycache__/

# Modelle (je ca. 650 MB) werden nicht versioniert, außer den Trainingsprotokollen und Modell v2
modelle/**
!modelle/**/
!modelle/**/*.log
# Modell v2 (aktiv in der Demo) wird über Git LFS versioniert, siehe .gitattributes
!modelle/laya-multilingual-kyc-v2/**

# Build-Ausgaben und Laufzeit-Logs
kyc-prozess/target/
logs/
node_modules/

# Lokale Einstellungen und Systemdateien
.claude/settings.local.json
.DS_Store
~$*
